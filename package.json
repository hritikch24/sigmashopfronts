{
  "name": "sigmashopfronts",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node --no-warnings --import ./tests/ts-paths.mjs scripts/launch-gate.mjs",
    "build": "prisma generate && prisma db push --skip-generate && next build && npm run gate && npm run test:sanity",
    "build:local": "next build && npm run gate",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "gate": "node scripts/originality-gate.mjs",
    "gate:snapshot": "node scripts/originality-gate.mjs --snapshot",
    "test:contamination": "node tests/contamination.test.mjs",
    "test:frontage": "node --no-warnings --import ./tests/ts-paths.mjs tests/frontage.test.mjs",
    "test:sanity": "node --no-warnings --import ./tests/ts-paths.mjs tests/sanity.test.mjs",
    "test:links": "node --no-warnings --import ./tests/ts-paths.mjs tests/links.test.mjs",
    "test:smoke": "node tests/smoke.test.mjs",
    "test": "npm run test:contamination && npm run test:frontage && npm run test:sanity",
    "indexnow": "node --no-warnings --import ./tests/ts-paths.mjs scripts/indexnow.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "next": "16.2.4",
    "openai": "^6.35.0",
    "prisma": "^6.19.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.12.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
